generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  businessName      String?
  businessType      String?
  monthlyGoal       Float?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime @default(now())

  vendas   Venda[]
  products Product[]
}

model Venda {
  id            String   @id @default(uuid())
  produto       String
  categoria     String?
  quantidade    Int      @default(1)
  precoUnitario Float    @default(0)
  valor         Float
  pagamento     String
  status        String   @default("Concluída")
  createdAt     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String?
  price     Float
  stock     Int
  minStock  Int?
  imageUrl  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  vendas Venda[]
}