generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  businessName      String?
  businessType      String?
  monthlyGoal       Float?
  businessLogoUrl   String?
  phone             String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime @default(now())

  vendas        Venda[]
  products      Product[]
  notifications Notification[]
}

model Venda {
  id            String   @id @default(uuid())
  produto       String
  categoria     String?
  quantidade    Int      @default(1)
  precoUnitario Float    @default(0)
  valor         Float
  pagamento     String
  status        String   @default("Concluída")
  createdAt     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String?
  price     Float
  stock     Int
  minStock  Int?
  imageUrl  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  vendas Venda[]
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String   @default("info")
  icon       String   @default("bell")
  kind       String?
  sourceId   String?
  sourceType String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, kind])
  @@index([userId, createdAt])
}