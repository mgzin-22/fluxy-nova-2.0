generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  businessName String?
  businessType String?
  monthlyGoal  Float?
  createdAt    DateTime @default(now())

  vendas   Venda[]
  products Product[]
}

model Venda {
  id        String   @id @default(uuid())
  produto   String
  valor     Float
  pagamento String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Float
  stock     Int
  minStock  Int?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
